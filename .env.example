# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# required for ingestion (Session 2)
TMDB_API_KEY=
TMDB_REQUESTS_PER_SECOND=4  # conservative client-side throttle, not a documented TMDB limit

# shared frontend<->backend secret; lives only in the Streamlit + API env
API_KEY=
# CORS allow-list for the API, e.g. https://movies.<you>.dev (Session 9+)
FRONTEND_ORIGIN=
API_BASE_URL=http://api:8000               # frontend -> backend (internal in compose)

MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB=movie_recs

VLLM_BASE_URL=http://vllm:8000/v1
VLLM_MODEL=meta-llama/Llama-3.2-3B-Instruct

EMBED_BASE_URL=http://embedding:8080
TEXT_EMBED_MODEL=BAAI/bge-small-en-v1.5      # 384-dim
CLIP_MODEL=ViT-B-32                          # 512-dim
EMBED_BATCH_SIZE=64
# blank lets sentence-transformers choose (CUDA when present); "cpu"/"cuda" forces
EMBED_DEVICE=

# for the cloudflared service (public demo only)
CLOUDFLARE_TUNNEL_TOKEN=
